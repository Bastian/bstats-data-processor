          "filter": {
            "enabled": false,
            "useRegex": false,
            "blacklist": false,
            "filter": []
          }
        },
        "requestParser": {
          "predefinedValue": "%country.name%"
        },
        "idCustom": "location"
      },
      {
        "type": "drilldown_pie",
        "title": "Java Version",
        "data": {
          "filter": {
            "enabled": false,
